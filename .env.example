# Copy this file to .env and fill in real values before running the app.
# On cPanel/Passenger hosting, don't use this file at all — set these as
# Environment Variables in Setup Node.js App instead. Never commit a real
# .env file (this one is a template only, with blank/placeholder values).

# Port the Node.js server listens on.
PORT=3000

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Set to "production" when deployed behind HTTPS (nginx, etc). This makes
# session cookies "secure" (HTTPS-only). Leave unset for local http dev.
NODE_ENV=development

# Admin login — created automatically on first boot if no user exists yet.
# After that, edit the password by running: npm run seed
ADMIN_EMAIL=you@syndicatemarketing.co
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Admin

# Shown in the browser tab / PWA name.
APP_NAME=Syndicate Client Hub
