<div class="page-header">
  <h1>Invoices</h1>
</div>

<div class="chip-row">
  <a href="/invoices" class="chip <%= !status ? 'is-active' : '' %>">All</a>
  <% STATUSES.forEach(function(s) { %>
    <a href="/invoices?status=<%= s %>" class="chip <%= status === s ? 'is-active' : '' %>"><%= statusLabel(s) %></a>
  <% }) %>
</div>

<% if (!invoices.length) { %>
  <div class="empty-state">
    <h1>No invoices</h1>
    <p>Create one from a client's page.</p>
  </div>
<% } else { %>
  <div class="stack">
    <% invoices.forEach(function(inv) { %>
      <a href="/invoices/<%= inv.id %>" class="card-link">
        <div class="list-row">
          <div>
            <div class="list-row__title">#<%= inv.invoice_number %></div>
            <div class="list-row__meta"><%= inv.client_name %> · <%= shortDate(inv.issue_date) %></div>
          </div>
          <div style="text-align:right;">
            <div class="list-row__title"><%= money(inv.total) %></div>
            <span class="badge badge--<%= inv.status %>"><%= statusLabel(inv.status) %></span>
          </div>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>
