<a href="/clients/<%= clientRecord.id %>" class="back-link">‹ Back to <%= clientRecord.business_name %></a>

<div class="page-header">
  <h1>New Invoice</h1>
</div>

<form class="form" method="POST" action="/clients/<%= clientRecord.id %>/invoices">
  <div class="field-row">
    <label class="field">
      <span>Invoice #</span>
      <input type="text" name="invoice_number" value="<%= suggestedNumber %>">
    </label>
    <label class="field">
      <span>Issue Date</span>
      <input type="date" name="issue_date" value="<%= todayISO() %>">
    </label>
  </div>
  <label class="field">
    <span>Due Date</span>
    <input type="date" name="due_date">
  </label>

  <div class="section-title" style="margin-top:6px;"><h2>Line Items</h2></div>
  <div id="item-rows" class="stack">
    <% for (let i = 0; i < 3; i++) { %>
      <div class="field-row">
        <label class="field" style="flex:3;">
          <span>Description</span>
          <input type="text" name="item_description" placeholder="e.g. Website design — homepage">
        </label>
        <label class="field" style="flex:1;">
          <span>Qty</span>
          <input type="number" name="item_quantity" value="1" min="0" step="0.5">
        </label>
        <label class="field" style="flex:1;">
          <span>Price</span>
          <input type="number" name="item_price" min="0" step="0.01" placeholder="0.00">
        </label>
      </div>
    <% } %>
  </div>
  <button type="button" id="add-row" class="btn btn--sm">+ Add line</button>

  <label class="field">
    <span>Notes</span>
    <textarea name="notes" placeholder="Payment terms, thank-you note, etc."></textarea>
  </label>

  <div class="form-actions">
    <button type="submit" class="btn btn--primary">Create Invoice</button>
  </div>
</form>

<script>
  document.getElementById('add-row').addEventListener('click', function () {
    const rows = document.getElementById('item-rows');
    const row = rows.children[0].cloneNode(true);
    row.querySelectorAll('input').forEach(function (input) {
      if (input.name === 'item_quantity') { input.value = '1'; } else { input.value = ''; }
    });
    rows.appendChild(row);
  });
</script>
