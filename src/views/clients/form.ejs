<% const c = clientRecord || {}; %>
<a href="<%= clientRecord ? '/clients/' + clientRecord.id : '/clients' %>" class="back-link">‹ Back</a>

<div class="page-header">
  <h1><%= clientRecord ? 'Edit Client' : 'New Client' %></h1>
</div>

<form class="form" method="POST" action="<%= clientRecord ? '/clients/' + clientRecord.id + '/edit' : '/clients' %>">
  <label class="field">
    <span>Business Name *</span>
    <input type="text" name="business_name" value="<%= c.business_name || '' %>" required autofocus placeholder="e.g. Riverside Coffee Co.">
  </label>

  <div class="field-row">
    <label class="field">
      <span>Contact Name</span>
      <input type="text" name="contact_name" value="<%= c.contact_name || '' %>" placeholder="Owner / point of contact">
    </label>
  </div>

  <div class="field-row">
    <label class="field">
      <span>Phone</span>
      <input type="tel" name="phone" value="<%= c.phone || '' %>" placeholder="(555) 555-5555">
    </label>
    <label class="field">
      <span>Email</span>
      <input type="email" name="email" value="<%= c.email || '' %>" placeholder="name@business.com">
    </label>
  </div>

  <label class="field">
    <span>Website</span>
    <input type="url" name="website" value="<%= c.website || '' %>" placeholder="https://">
  </label>

  <label class="field">
    <span>Address</span>
    <input type="text" name="address" value="<%= c.address || '' %>" placeholder="Street, city, state">
  </label>

  <div class="field-row">
    <label class="field">
      <span>Industry</span>
      <select name="industry">
        <option value="">Select…</option>
        <% INDUSTRIES.forEach(function(i) { %>
          <option value="<%= i %>" <%= c.industry === i ? 'selected' : '' %>><%= i %></option>
        <% }) %>
      </select>
    </label>
    <label class="field">
      <span>Source</span>
      <select name="source">
        <option value="">Select…</option>
        <% SOURCES.forEach(function(s) { %>
          <option value="<%= s %>" <%= c.source === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </label>
  </div>

  <div class="field-row">
    <label class="field">
      <span>Status</span>
      <select name="status">
        <% STATUSES.forEach(function(s) { %>
          <option value="<%= s %>" <%= (c.status || 'lead') === s ? 'selected' : '' %>><%= statusLabel(s) %></option>
        <% }) %>
      </select>
    </label>
    <label class="field">
      <span>Monthly Value ($)</span>
      <input type="number" step="0.01" min="0" name="monthly_value" value="<%= c.monthly_value || '' %>" placeholder="0.00">
    </label>
  </div>

  <label class="field">
    <span>Notes</span>
    <textarea name="notes" placeholder="Anything worth remembering — goals, preferences, history…"><%= c.notes || '' %></textarea>
  </label>

  <div class="form-actions">
    <button type="submit" class="btn btn--primary"><%= clientRecord ? 'Save Changes' : 'Create Client' %></button>
  </div>
</form>
