<div class="page-header">
  <h1>Tasks</h1>
</div>

<div class="chip-row">
  <a href="/tasks?filter=open" class="chip <%= filter === 'open' ? 'is-active' : '' %>">Open</a>
  <a href="/tasks?filter=done" class="chip <%= filter === 'done' ? 'is-active' : '' %>">Done</a>
  <a href="/tasks?filter=all" class="chip <%= filter === 'all' ? 'is-active' : '' %>">All</a>
</div>

<form method="POST" action="/tasks" class="card">
  <div class="inline-form">
    <input type="text" name="title" placeholder="Quick add a task…" required>
    <input type="date" name="due_date" style="max-width:140px;">
  </div>
  <button type="submit" class="btn btn--primary btn--block" style="margin-top:10px;">Add Task</button>
</form>

<% if (!tasks.length) { %>
  <div class="empty-state">
    <h1>Nothing here</h1>
    <p>You're all caught up.</p>
  </div>
<% } %>

<% tasks.forEach(function(t) { %>
  <div class="card task-row">
    <form method="POST" action="/tasks/<%= t.id %>/toggle">
      <button type="submit" class="task-row__check <%= t.completed ? 'is-done' : '' %>"><%= t.completed ? '✓' : '' %></button>
    </form>
    <div class="task-row__body">
      <div class="task-row__title <%= t.completed ? 'is-done' : '' %>"><%= t.title %></div>
      <div class="task-row__meta <%= isOverdue(t.due_date, t.completed) ? 'is-overdue' : '' %>">
        <% if (t.client_name) { %><a href="/clients/<%= t.client_id %>" style="color:var(--accent);"><%= t.client_name %></a><% } %>
        <% if (t.client_name && t.due_date) { %> · <% } %>
        <% if (t.due_date) { %>Due <%= shortDate(t.due_date) %><% } %>
      </div>
    </div>
    <form method="POST" action="/tasks/<%= t.id %>/delete" data-confirm="Delete this task?">
      <button type="submit" class="btn btn--sm btn--ghost">✕</button>
    </form>
  </div>
<% }) %>
